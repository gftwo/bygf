{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && auth.token.email === 'admin@keuangan.pro'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'admin@keuangan.pro')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'admin@keuangan.pro')",
        "appData": { ".validate": "newData.hasChildren()" },
        "profile": { ".validate": "newData.hasChildren()" },
        "$other": { ".validate": false }
      }
    }
  }
}
